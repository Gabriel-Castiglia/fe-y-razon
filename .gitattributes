# Finales de línea: SIEMPRE LF, en cualquier equipo (Mac, Windows, Linux).
* text=auto eol=lf

# Binarios: git no los toca.
*.webp binary
*.jpg  binary
*.png  binary
*.mp4  binary
*.webm binary

# Fuentes: binarias, git no debe normalizarles los finales de línea.
*.woff2 binary
*.woff  binary
*.ttf   binary
*.otf   binary
